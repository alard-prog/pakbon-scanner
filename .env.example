# --- Dashboard ---
# Wachtwoord om bij het dashboard te kunnen (verplicht, kies zelf iets).
DASHBOARD_PASSWORD=

# Gebruikersnaam voor het dashboard (optioneel, standaard "admin").
DASHBOARD_USERNAME=admin

# --- Hosting ---
# De publieke URL waarop deze app straks bereikbaar is (bv. je Railway-domein).
# Nodig zodat Coda de foto's kan ophalen, en om zelf bij het dashboard te
# kunnen. Zonder https:// werkt het niet.
PUBLIC_BASE_URL=https://jouw-app.up.railway.app

PORT=3000

# --- Alleen nodig als je van de oudere, enkelvoudige versie van deze app ---
# --- update (vóór het dashboard). Zie README.md "Stap 3" voor uitleg.   ---
# WHATSAPP_GROUP_NAME=
# CODA_API_TOKEN=
# CODA_DOC_ID=
# CODA_TABLE_ID=
# FLUSH_DELAY_MS=15000
