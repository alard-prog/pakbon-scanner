# --- Coda ---
# Account-instellingen in Coda -> "API settings" -> "Generate API token"
CODA_API_TOKEN=

# Uit de URL van je Coda-doc: https://coda.io/d/Mijn-doc_dXXXXXXXXXX
# Het stuk na "_d" is de DOC_ID (bv. dXXXXXXXXXX)
CODA_DOC_ID=

# Table ID (of tabelnaam) van de tabel "Meldingen" binnen dat doc.
# Te vinden via de Coda API "list tables" endpoint, of gewoon de exacte
# tabelnaam gebruiken zoals die in Coda staat (bv. "Meldingen").
CODA_TABLE_ID=Meldingen

# --- WhatsApp ---
# Exacte naam van de WhatsApp-groep die uitgelezen moet worden.
WHATSAPP_GROUP_NAME=Peppy Hop

# Hoeveel ms wachten na het laatste bericht van een afzender voordat een
# "melding" als compleet wordt beschouwd en wordt wegeschreven naar Coda.
FLUSH_DELAY_MS=15000

# --- Hosting ---
# De publieke URL waarop deze app straks bereikbaar is (bv. je Railway-domein).
# Nodig zodat Coda de foto's kan ophalen. Zonder https:// werkt het niet.
PUBLIC_BASE_URL=https://jouw-app.up.railway.app

PORT=3000
